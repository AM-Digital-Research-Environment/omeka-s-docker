<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
    xmlns:dcterms="http://purl.org/dc/terms/"
    xmlns:vann="http://purl.org/vocab/vann/"
    xmlns:dre="https://data.africamultiple.uni-bayreuth.de/ontology/dre#">

  <owl:Ontology rdf:about="https://data.africamultiple.uni-bayreuth.de/ontology/dre">
    <rdfs:label xml:lang="en">DRE</rdfs:label>
    <dcterms:title xml:lang="en">DRE — Africa Multiple Digital Research Environment vocabulary</dcterms:title>
    <rdfs:comment xml:lang="en">Properties the Africa Multiple Digital Research Environment adds to Dublin Core, BIBO, FOAF and the other vocabularies of AMIRA, the Africa Multiple Interactive Research Atlas: identifiers and links into the University of Bayreuth's systems, provenance of machine-generated values, and the internal fields that keep AMIRA in sync with its source database.</rdfs:comment>
    <dcterms:publisher rdf:resource="http://www.wikidata.org/entity/Q141717295"/>
    <dcterms:license rdf:resource="https://creativecommons.org/publicdomain/zero/1.0/"/>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</dcterms:modified>
    <vann:preferredNamespacePrefix>dre</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>https://data.africamultiple.uni-bayreuth.de/ontology/dre#</vann:preferredNamespaceUri>
    <owl:priorVersion rdf:resource="http://am-digital.org/ontology/dre/"/>
    <rdfs:seeAlso rdf:resource="https://data.africamultiple.uni-bayreuth.de/linked-data/void"/>
  </owl:Ontology>

  <rdf:Property rdf:about="https://data.africamultiple.uni-bayreuth.de/ontology/dre#id">
    <rdfs:label xml:lang="en">DRE ID</rdfs:label>
    <rdfs:comment xml:lang="en">Internal identifier used by the Digital Research Environment.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://data.africamultiple.uni-bayreuth.de/ontology/dre"/>
    <owl:equivalentProperty rdf:resource="http://am-digital.org/ontology/dre/id"/>
  </rdf:Property>

  <rdf:Property rdf:about="https://data.africamultiple.uni-bayreuth.de/ontology/dre#security">
    <rdfs:label xml:lang="en">Security level</rdfs:label>
    <rdfs:comment xml:lang="en">Data sensitivity level (DSL1-DSL5) defining access restrictions.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://data.africamultiple.uni-bayreuth.de/ontology/dre"/>
    <owl:equivalentProperty rdf:resource="http://am-digital.org/ontology/dre/security"/>
  </rdf:Property>

  <rdf:Property rdf:about="https://data.africamultiple.uni-bayreuth.de/ontology/dre#bitstream">
    <rdfs:label xml:lang="en">Bitstream</rdfs:label>
    <rdfs:comment xml:lang="en">Filename of the associated digital object or file.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://data.africamultiple.uni-bayreuth.de/ontology/dre"/>
    <owl:equivalentProperty rdf:resource="http://am-digital.org/ontology/dre/bitstream"/>
  </rdf:Property>

  <rdf:Property rdf:about="https://data.africamultiple.uni-bayreuth.de/ontology/dre#mongoId">
    <rdfs:label xml:lang="en">MongoDB ID</rdfs:label>
    <rdfs:comment xml:lang="en">Original MongoDB ObjectId, used for sync reconciliation. Should be private.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://data.africamultiple.uni-bayreuth.de/ontology/dre"/>
    <owl:equivalentProperty rdf:resource="http://am-digital.org/ontology/dre/mongoId"/>
  </rdf:Property>

  <rdf:Property rdf:about="https://data.africamultiple.uni-bayreuth.de/ontology/dre#rdspaceHandle">
    <rdfs:label xml:lang="en">RDSpace Handle</rdfs:label>
    <rdfs:comment xml:lang="en">Persistent handle URL from the RDSpace repository at the University of Bayreuth (rdspace.uni-bayreuth.de).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://data.africamultiple.uni-bayreuth.de/ontology/dre"/>
    <owl:equivalentProperty rdf:resource="http://am-digital.org/ontology/dre/rdspaceHandle"/>
  </rdf:Property>

  <rdf:Property rdf:about="https://data.africamultiple.uni-bayreuth.de/ontology/dre#collectionUrl">
    <rdfs:label xml:lang="en">Collection URL</rdfs:label>
    <rdfs:comment xml:lang="en">Permalink to the item in the University of Bayreuth Digital Collections (DSpace) platform at collections.uni-bayreuth.de. A different system from RDSpace.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://data.africamultiple.uni-bayreuth.de/ontology/dre"/>
    <owl:equivalentProperty rdf:resource="http://am-digital.org/ontology/dre/collectionUrl"/>
  </rdf:Property>

  <rdf:Property rdf:about="https://data.africamultiple.uni-bayreuth.de/ontology/dre#generatedBy">
    <rdfs:label xml:lang="en">Generated by</rdfs:label>
    <rdfs:comment xml:lang="en">The agent — typically an AI model — that automatically generated this value (e.g. a machine-produced transcript, description or translation). Used as a value annotation pointing to the generating tool's authority record, distinguishing machine-generated content from a human contributor role.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://data.africamultiple.uni-bayreuth.de/ontology/dre"/>
    <owl:equivalentProperty rdf:resource="http://am-digital.org/ontology/dre/generatedBy"/>
  </rdf:Property>

  <rdf:Property rdf:about="https://data.africamultiple.uni-bayreuth.de/ontology/dre#series">
    <rdfs:label xml:lang="en">Series</rdfs:label>
    <rdfs:comment xml:lang="en">The bibliographic series (and series number) a publication belongs to, e.g. 'BIGSASworks!; 23'. Kept distinct from dcterms:isPartOf, which holds the publication's single immediate container (its journal or book) — a monograph or working paper with no such container uses its primary series as the isPartOf container instead, and only a secondary series statement lands here.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://data.africamultiple.uni-bayreuth.de/ontology/dre"/>
    <owl:equivalentProperty rdf:resource="http://am-digital.org/ontology/dre/series"/>
  </rdf:Property>

  <rdf:Property rdf:about="https://data.africamultiple.uni-bayreuth.de/ontology/dre#wisskiUrl">
    <rdfs:label xml:lang="en">WissKI URL</rdfs:label>
    <rdfs:comment xml:lang="en">Navigate URL to the item in the WissKI knowledge base at the University of Bayreuth. No longer populated: WissKI links were retired from the sync.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://data.africamultiple.uni-bayreuth.de/ontology/dre"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <owl:equivalentProperty rdf:resource="http://am-digital.org/ontology/dre/wisskiUrl"/>
  </rdf:Property>

</rdf:RDF>
