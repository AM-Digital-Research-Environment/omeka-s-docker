{
  "@context": {
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "dcterms": "http://purl.org/dc/terms/",
    "vann": "http://purl.org/vocab/vann/",
    "dre": "https://data.africamultiple.uni-bayreuth.de/ontology/dre#"
  },
  "@graph": [
    {
      "@id": "https://data.africamultiple.uni-bayreuth.de/ontology/dre",
      "@type": "owl:Ontology",
      "rdfs:label": {
        "@value": "DRE",
        "@language": "en"
      },
      "dcterms:title": {
        "@value": "DRE — Africa Multiple Digital Research Environment vocabulary",
        "@language": "en"
      },
      "rdfs:comment": {
        "@value": "Properties the Africa Multiple Digital Research Environment adds to Dublin Core, BIBO, FOAF and the other vocabularies of AMIRA, the Africa Multiple Interactive Research Atlas: identifiers and links into the University of Bayreuth's systems, provenance of machine-generated values, and the internal fields that keep AMIRA in sync with its source database.",
        "@language": "en"
      },
      "dcterms:publisher": {
        "@id": "http://www.wikidata.org/entity/Q141717295"
      },
      "dcterms:license": {
        "@id": "https://creativecommons.org/publicdomain/zero/1.0/"
      },
      "dcterms:modified": {
        "@value": "2026-10-15",
        "@type": "xsd:date"
      },
      "vann:preferredNamespacePrefix": "dre",
      "vann:preferredNamespaceUri": "https://data.africamultiple.uni-bayreuth.de/ontology/dre#",
      "owl:priorVersion": {
        "@id": "http://am-digital.org/ontology/dre/"
      },
      "rdfs:seeAlso": {
        "@id": "https://data.africamultiple.uni-bayreuth.de/linked-data/void"
      }
    },
    {
      "@id": "dre:id",
      "@type": "rdf:Property",
      "rdfs:label": {
        "@value": "DRE ID",
        "@language": "en"
      },
      "rdfs:comment": {
        "@value": "Internal identifier used by the Digital Research Environment.",
        "@language": "en"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://data.africamultiple.uni-bayreuth.de/ontology/dre"
      },
      "owl:equivalentProperty": {
        "@id": "http://am-digital.org/ontology/dre/id"
      }
    },
    {
      "@id": "dre:security",
      "@type": "rdf:Property",
      "rdfs:label": {
        "@value": "Security level",
        "@language": "en"
      },
      "rdfs:comment": {
        "@value": "Data sensitivity level (DSL1-DSL5) defining access restrictions.",
        "@language": "en"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://data.africamultiple.uni-bayreuth.de/ontology/dre"
      },
      "owl:equivalentProperty": {
        "@id": "http://am-digital.org/ontology/dre/security"
      }
    },
    {
      "@id": "dre:bitstream",
      "@type": "rdf:Property",
      "rdfs:label": {
        "@value": "Bitstream",
        "@language": "en"
      },
      "rdfs:comment": {
        "@value": "Filename of the associated digital object or file.",
        "@language": "en"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://data.africamultiple.uni-bayreuth.de/ontology/dre"
      },
      "owl:equivalentProperty": {
        "@id": "http://am-digital.org/ontology/dre/bitstream"
      }
    },
    {
      "@id": "dre:mongoId",
      "@type": "rdf:Property",
      "rdfs:label": {
        "@value": "MongoDB ID",
        "@language": "en"
      },
      "rdfs:comment": {
        "@value": "Original MongoDB ObjectId, used for sync reconciliation. Should be private.",
        "@language": "en"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://data.africamultiple.uni-bayreuth.de/ontology/dre"
      },
      "owl:equivalentProperty": {
        "@id": "http://am-digital.org/ontology/dre/mongoId"
      }
    },
    {
      "@id": "dre:rdspaceHandle",
      "@type": "rdf:Property",
      "rdfs:label": {
        "@value": "RDSpace Handle",
        "@language": "en"
      },
      "rdfs:comment": {
        "@value": "Persistent handle URL from the RDSpace repository at the University of Bayreuth (rdspace.uni-bayreuth.de).",
        "@language": "en"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://data.africamultiple.uni-bayreuth.de/ontology/dre"
      },
      "owl:equivalentProperty": {
        "@id": "http://am-digital.org/ontology/dre/rdspaceHandle"
      }
    },
    {
      "@id": "dre:collectionUrl",
      "@type": "rdf:Property",
      "rdfs:label": {
        "@value": "Collection URL",
        "@language": "en"
      },
      "rdfs:comment": {
        "@value": "Permalink to the item in the University of Bayreuth Digital Collections (DSpace) platform at collections.uni-bayreuth.de. A different system from RDSpace.",
        "@language": "en"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://data.africamultiple.uni-bayreuth.de/ontology/dre"
      },
      "owl:equivalentProperty": {
        "@id": "http://am-digital.org/ontology/dre/collectionUrl"
      }
    },
    {
      "@id": "dre:generatedBy",
      "@type": "rdf:Property",
      "rdfs:label": {
        "@value": "Generated by",
        "@language": "en"
      },
      "rdfs:comment": {
        "@value": "The agent — typically an AI model — that automatically generated this value (e.g. a machine-produced transcript, description or translation). Used as a value annotation pointing to the generating tool's authority record, distinguishing machine-generated content from a human contributor role.",
        "@language": "en"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://data.africamultiple.uni-bayreuth.de/ontology/dre"
      },
      "owl:equivalentProperty": {
        "@id": "http://am-digital.org/ontology/dre/generatedBy"
      }
    },
    {
      "@id": "dre:series",
      "@type": "rdf:Property",
      "rdfs:label": {
        "@value": "Series",
        "@language": "en"
      },
      "rdfs:comment": {
        "@value": "The bibliographic series (and series number) a publication belongs to, e.g. 'BIGSASworks!; 23'. Kept distinct from dcterms:isPartOf, which holds the publication's single immediate container (its journal or book) — a monograph or working paper with no such container uses its primary series as the isPartOf container instead, and only a secondary series statement lands here.",
        "@language": "en"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://data.africamultiple.uni-bayreuth.de/ontology/dre"
      },
      "owl:equivalentProperty": {
        "@id": "http://am-digital.org/ontology/dre/series"
      }
    },
    {
      "@id": "dre:wisskiUrl",
      "@type": "rdf:Property",
      "rdfs:label": {
        "@value": "WissKI URL",
        "@language": "en"
      },
      "rdfs:comment": {
        "@value": "Navigate URL to the item in the WissKI knowledge base at the University of Bayreuth. No longer populated: WissKI links were retired from the sync.",
        "@language": "en"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://data.africamultiple.uni-bayreuth.de/ontology/dre"
      },
      "owl:deprecated": true,
      "owl:equivalentProperty": {
        "@id": "http://am-digital.org/ontology/dre/wisskiUrl"
      }
    }
  ]
}
