@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix dre: <https://data.africamultiple.uni-bayreuth.de/ontology/dre#> .

<https://data.africamultiple.uni-bayreuth.de/ontology/dre>
    a owl:Ontology ;
    rdfs:label "DRE"@en ;
    dcterms:title "DRE — Africa Multiple Digital Research Environment vocabulary"@en ;
    rdfs:comment "Properties the Africa Multiple Digital Research Environment adds to Dublin Core, BIBO, FOAF and the other vocabularies of AMIRA, the Africa Multiple Interactive Research Atlas: identifiers and links into the University of Bayreuth's systems, provenance of machine-generated values, and the internal fields that keep AMIRA in sync with its source database."@en ;
    dcterms:publisher <http://www.wikidata.org/entity/Q141717295> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:modified "2026-10-15"^^xsd:date ;
    vann:preferredNamespacePrefix "dre" ;
    vann:preferredNamespaceUri "https://data.africamultiple.uni-bayreuth.de/ontology/dre#" ;
    owl:priorVersion <http://am-digital.org/ontology/dre/> ;
    rdfs:seeAlso <https://data.africamultiple.uni-bayreuth.de/linked-data/void> .

dre:id
    a rdf:Property ;
    rdfs:label "DRE ID"@en ;
    rdfs:comment "Internal identifier used by the Digital Research Environment."@en ;
    rdfs:isDefinedBy <https://data.africamultiple.uni-bayreuth.de/ontology/dre> ;
    owl:equivalentProperty <http://am-digital.org/ontology/dre/id> .

dre:security
    a rdf:Property ;
    rdfs:label "Security level"@en ;
    rdfs:comment "Data sensitivity level (DSL1-DSL5) defining access restrictions."@en ;
    rdfs:isDefinedBy <https://data.africamultiple.uni-bayreuth.de/ontology/dre> ;
    owl:equivalentProperty <http://am-digital.org/ontology/dre/security> .

dre:bitstream
    a rdf:Property ;
    rdfs:label "Bitstream"@en ;
    rdfs:comment "Filename of the associated digital object or file."@en ;
    rdfs:isDefinedBy <https://data.africamultiple.uni-bayreuth.de/ontology/dre> ;
    owl:equivalentProperty <http://am-digital.org/ontology/dre/bitstream> .

dre:mongoId
    a rdf:Property ;
    rdfs:label "MongoDB ID"@en ;
    rdfs:comment "Original MongoDB ObjectId, used for sync reconciliation. Should be private."@en ;
    rdfs:isDefinedBy <https://data.africamultiple.uni-bayreuth.de/ontology/dre> ;
    owl:equivalentProperty <http://am-digital.org/ontology/dre/mongoId> .

dre:rdspaceHandle
    a rdf:Property ;
    rdfs:label "RDSpace Handle"@en ;
    rdfs:comment "Persistent handle URL from the RDSpace repository at the University of Bayreuth (rdspace.uni-bayreuth.de)."@en ;
    rdfs:isDefinedBy <https://data.africamultiple.uni-bayreuth.de/ontology/dre> ;
    owl:equivalentProperty <http://am-digital.org/ontology/dre/rdspaceHandle> .

dre:collectionUrl
    a rdf:Property ;
    rdfs:label "Collection URL"@en ;
    rdfs:comment "Permalink to the item in the University of Bayreuth Digital Collections (DSpace) platform at collections.uni-bayreuth.de. A different system from RDSpace."@en ;
    rdfs:isDefinedBy <https://data.africamultiple.uni-bayreuth.de/ontology/dre> ;
    owl:equivalentProperty <http://am-digital.org/ontology/dre/collectionUrl> .

dre:generatedBy
    a rdf:Property ;
    rdfs:label "Generated by"@en ;
    rdfs:comment "The agent — typically an AI model — that automatically generated this value (e.g. a machine-produced transcript, description or translation). Used as a value annotation pointing to the generating tool's authority record, distinguishing machine-generated content from a human contributor role."@en ;
    rdfs:isDefinedBy <https://data.africamultiple.uni-bayreuth.de/ontology/dre> ;
    owl:equivalentProperty <http://am-digital.org/ontology/dre/generatedBy> .

dre:series
    a rdf:Property ;
    rdfs:label "Series"@en ;
    rdfs:comment "The bibliographic series (and series number) a publication belongs to, e.g. 'BIGSASworks!; 23'. Kept distinct from dcterms:isPartOf, which holds the publication's single immediate container (its journal or book) — a monograph or working paper with no such container uses its primary series as the isPartOf container instead, and only a secondary series statement lands here."@en ;
    rdfs:isDefinedBy <https://data.africamultiple.uni-bayreuth.de/ontology/dre> ;
    owl:equivalentProperty <http://am-digital.org/ontology/dre/series> .

dre:wisskiUrl
    a rdf:Property ;
    rdfs:label "WissKI URL"@en ;
    rdfs:comment "Navigate URL to the item in the WissKI knowledge base at the University of Bayreuth. No longer populated: WissKI links were retired from the sync."@en ;
    rdfs:isDefinedBy <https://data.africamultiple.uni-bayreuth.de/ontology/dre> ;
    owl:deprecated true ;
    owl:equivalentProperty <http://am-digital.org/ontology/dre/wisskiUrl> .
