# Omeka S Docker Template - settings
#
# Copy this file to .env and edit it. Only MYSQL_PASSWORD is required; every
# other line is commented out and shows its default.
#
# Settings marked REBUILD become part of the image. After changing one, run
#   bash scripts/rebuild-code.sh
# rather than just restarting.

# Database password (required). Use a long random one, e.g. `openssl rand -hex 24`.
# (Or keep it, and the other credentials below, in files instead of here: see
# "File-based secrets" at the end of this file.)
MYSQL_PASSWORD=your_secure_mysql_password_here

# Database name and user. These are set when the database is first created;
# changing them later does NOT rename an existing database or user.
# MYSQL_DATABASE=omeka
# MYSQL_USER=omeka

# The first admin account. The first start always installs Omeka by itself;
# there is no browser-based installer. With all three values set, it creates
# this account. Otherwise it creates admin@example.com (or OMEKA_ADMIN_EMAIL)
# with a random password, printed once in `docker compose logs php` as
# "Generated admin password: ...": sign in and change it. The values are only
# read by that first install: remove all three from .env afterwards (the php
# container logs a warning while OMEKA_ADMIN_PASSWORD is still set on an
# installed site) and recreate php with `docker compose up -d php`.
# OMEKA_ADMIN_EMAIL=
# OMEKA_ADMIN_PASSWORD=
# OMEKA_ADMIN_USERNAME=
# OMEKA_TZ="Europe/Berlin"
# OMEKA_LOCALE="en_US"
# OMEKA_TITLE=

# Encryption key for secrets at rest (module API keys and similar). Omeka
# normally writes config/secret_key.php itself, but config/ is immutable image
# content in this template, so that write fails and the admin shows a warning
# on every page until this is set. Generate it once:
#   openssl rand -base64 32
# Then NEVER change it: whatever was already encrypted with the old value
# becomes unreadable. Treat it like MYSQL_PASSWORD — back it up with .env.
# OMEKA_SECRET_KEY=

# Session cookie. Set SECURE to true whenever the site is served over HTTPS
# (behind a TLS proxy), so the login cookie is never sent over plain HTTP.
# Leave it false for a plain-HTTP install, or nobody can log in.
# compose.tls.yml (below) defaults it to true; leave it unset there.
# OMEKA_SESSION_COOKIE_SECURE=false
# OMEKA_SESSION_COOKIE_SAMESITE=Lax

# At start, install modules that are on disk but not yet installed in the
# database. false leaves that to the admin, so a module an admin uninstalled
# stays uninstalled.
# OMEKA_AUTO_INSTALL_MODULES=true

# REBUILD. Which Omeka S release to install. "latest" takes whatever is newest
# at build time, which by definition has not been tested with this template.
# OMEKA_VERSION=4.2.1

# Read-only deployment override for Omeka's local.config.php. The default is
# tracked at _docker/local.config.php; backup/restore and legacy migration set
# this automatically when they preserve a site-specific file.
# OMEKA_LOCAL_CONFIG=./_docker/local.config.php

# Nginx port (optional, defaults to 80)
# NGINX_PORT=80

# Interface the nginx port binds to (optional, defaults to 127.0.0.1).
# The default keeps the stack reachable only through a reverse proxy running
# on the host (Caddy, nginx, Traefik). Set 0.0.0.0 to serve HTTP directly,
# e.g. for a plain install without a proxy.
# NGINX_BIND=127.0.0.1

# One trusted reverse proxy IP/CIDR. Narrow to your Docker gateway/proxy address
# after checking the network. The default covers ordinary Docker bridges.
# A custom 10.x/192.168.x bridge requires an explicit matching setting.
# For direct HTTP (NGINX_BIND=0.0.0.0, no proxy), use 192.0.2.1/32 to trust no
# actual peer; do not accept client-supplied forwarding headers.
# NGINX_TRUSTED_PROXY_CIDR=172.16.0.0/12

# Public hostname this Omeka S instance is served on (used in nginx server_name).
# Defaults to "_" (catch-all) if unset, which is fine when the container only
# accepts traffic from a trusted reverse proxy on 127.0.0.1.
# SERVER_NAME=omeka.example.edu

# CSP frame-ancestors: origins allowed to embed this site in an iframe.
# Defaults to 'self' (only the site itself). Space-separated origins; keep the
# literal quotes around 'self' and wrap the whole value in double quotes.
# FRAME_ANCESTORS="'self' https://www.example.org"

# HSTS: seconds for a Strict-Transport-Security header, sent only on requests
# the trusted proxy forwarded as HTTPS. 0 (the default) sends none. Set
# 31536000 once HTTPS is confirmed working — browsers then refuse plain HTTP for
# a year. Alternatively set HSTS on the TLS proxy itself (not both). With
# compose.tls.yml leave this at 0: Caddy sends HSTS (CADDY_HSTS_MAX_AGE).
# NGINX_HSTS_MAX_AGE=0

# Per-client rate limit on the Omeka REST API (/api). Off by default, so API
# clients, harvesters and the admin's own scripts behave as before. "on" limits
# each client address to NGINX_API_RATE (nginx limit_req syntax: 10r/s, 600r/m)
# after a burst of 20, and answers requests beyond it with 429 Too Many
# Requests. Behind a reverse proxy the client address is only right if
# NGINX_TRUSTED_PROXY_CIDR is, so check that first.
# NGINX_API_RATE_LIMIT=off
# NGINX_API_RATE=10r/s

# REBUILD. Extra modules and themes as comma-separated lists. These are build
# inputs, not something that installs into a running site. The files
# _docker/extra-modules.txt and _docker/extra-themes.txt are easier to review
# and to keep in version control, so prefer those.
# EXTRA_MODULES=DspaceConnector,CSSEditor
# EXTRA_THEMES=gh:omeka-s-themes/Cozy,gh:omeka-s-themes/Foundation

# REBUILD. Point these at your own module/theme lists — this is how a deployment
# folder adds its own without touching the shared files. Normally set inside a
# compose.<name>.yml rather than here (see compose.amira.yml).
# EXTRA_MODULES_FILE=_docker/empty-modules.txt
# EXTRA_THEMES_FILE=_docker/empty-themes.txt

# REBUILD. IIIF image viewing (installs IiifServer, ImageServer, Mirador).
# ENABLE_IIIF=true

# Typesense search backend for the DRESearch module (OPTIONAL).
# This stack runs fine without it — the search service only starts when you
# explicitly enable the "search" profile:
#   docker compose --profile search up -d
# Typesense stays on the internal network (never exposed to the host); the
# module talks to it server-side. Set a long random key — it is used by both
# the Typesense server and the module. Leave unset to run without search.
# TYPESENSE_API_KEY=change-me-to-a-long-random-string
# TYPESENSE_HOST=typesense
# TYPESENSE_PORT=8108
# TYPESENSE_PROTOCOL=http

# PHP-FPM pool tuning (optional - uncomment to override defaults)
# PHP_PM_MAX_CHILDREN=10
# PHP_PM_START_SERVERS=3
# PHP_PM_MIN_SPARE_SERVERS=2
# PHP_PM_MAX_SPARE_SERVERS=5
# PHP_PM_MAX_REQUESTS=500

# How many backup snapshots scripts/backup.sh keeps when it is asked to prune.
# 0 (the default) keeps everything. Each snapshot is a FULL database + media
# copy, so an unpruned backups/ grows without limit — set a number here or pass
# --keep N in your scheduled backup. Use 1 when an off-host incremental
# archiver (borg, restic) holds the real history.
# BACKUP_KEEP=7

# Container resource limits: adjust to your institution's host and workload.
# These do not change PHP's per-request memory_limit in uploads.ini, or the
# database buffer pool. Keep limits >= the reservations in docker-compose.yml.
# Five 512M PHP requests can exceed 1536M; measure imports and background jobs.
#
# These are ceilings, not allocations — but they are ceilings the host must be
# able to honour if several services peak together. The defaults below total
# 3328M (plus any overlay service), so on a 4 GB host leave something unset or
# trim one of them rather than raising several. Measure first with
# `bash scripts/health-report.sh` during a real import.
# PHP_CONTAINER_MEMORY=1536M
# PHP_CPU_LIMIT=1.0
# WEB_MEMORY_LIMIT=256M
# WEB_CPU_LIMIT=0.25
# DB_MEMORY_LIMIT=1G
# DB_CPU_LIMIT=0.5
# SEARCH_MEMORY_LIMIT=512M
# SEARCH_CPU_LIMIT=0.5

# ── Deployment overlays ──────────────────────────────────────────────────────
# Extra compose files layered on top of docker-compose.yml. Docker Compose
# reads COMPOSE_FILE and COMPOSE_PROFILES from this file, so activating an
# overlay is a one-time .env edit — every `docker compose` command then picks
# it up automatically. Example: the AMIRA production overlay
# (see deploy/amira/README.md):
# COMPOSE_FILE=docker-compose.yml:compose.amira.yml
# COMPOSE_PROFILES=search

# Immutable-extensions overlay (opt-in hardening): makes modules and themes
# image content again, so nothing under the document root is writable by PHP.
# EasyAdmin can then no longer install/update/remove them and every extension
# change becomes a pinned image rebuild (scripts/install-module.sh). Choose it
# for deployments administered from a terminal — see compose.immutable.yml and
# docs/IMMUTABLE_CODE.md.
#
# ORDER MATTERS: list it directly after docker-compose.yml, before any
# deployment overlay, or that overlay's own mounts are discarded.
# COMPOSE_FILE=docker-compose.yml:compose.immutable.yml
# COMPOSE_FILE=docker-compose.yml:compose.immutable.yml:compose.amira.yml

# Automatic HTTPS (opt-in): a bundled Caddy terminates TLS on ports 80/443 and
# obtains and renews a Let's Encrypt certificate by itself. Needs SERVER_NAME
# set to the public domain (not "_"), with DNS pointing at this host and ports
# 80 and 443 free; ACME_EMAIL is optional (expiry notices from the CA). It
# makes the session cookie Secure and sends HSTS itself. List it last; it
# replaces a host proxy, so do not combine it with compose.amira.yml.
# Details: docs/PRODUCTION.md, "Bundled HTTPS (Caddy)".
# COMPOSE_FILE=docker-compose.yml:compose.tls.yml
# COMPOSE_FILE=docker-compose.yml:compose.immutable.yml:compose.secrets.yml:compose.tls.yml
# SERVER_NAME=omeka.example.edu
# ACME_EMAIL=webmaster@example.edu
#
# Try it against Let's Encrypt's staging CA first (untrusted certificates,
# generous rate limits; production allows five identical certificates a week),
# then remove the line:
# ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
# "internal" issues the certificate from Caddy's own CA instead, for a machine
# without a public DNS name (browsers warn until its root is trusted):
# CADDY_TLS=acme
# Strict-Transport-Security max-age in seconds (default one year; 0 sends a
# header that clears HSTS):
# CADDY_HSTS_MAX_AGE=31536000
# CADDY_CPU_LIMIT=0.25
# CADDY_MEMORY_LIMIT=128M

# File-based secrets (opt-in): MYSQL_PASSWORD, OMEKA_SECRET_KEY,
# TYPESENSE_API_KEY and OMEKA_ADMIN_PASSWORD are read from one file each in
# SECRETS_DIR instead of from this file, so they no longer appear in .env,
# `docker compose config` or `docker inspect`. Create all four files first
# (empty = unset, so an empty omeka_admin_password means a generated one, as
# above; mysql_password must hold the password), mode 0644 inside a
# 0700 directory, then set the two lines below and DELETE those four variables
# from this file — php refuses to start while one is set in both places.
# Setup and caveats: compose.secrets.yml and docs/CONFIGURATION.md.
# Order: docker-compose.yml, [compose.immutable.yml], compose.secrets.yml,
# then a deployment overlay or compose.tls.yml.
# COMPOSE_FILE=docker-compose.yml:compose.secrets.yml
# COMPOSE_FILE=docker-compose.yml:compose.immutable.yml:compose.secrets.yml:compose.amira.yml
# SECRETS_DIR=./secrets

# Moving an existing Omeka S site (another server, a classic install) into
# this stack: see docs/MIGRATING.md.

# AMIRA overlay only: immutable upstream release used to build amira-mcp.
# Leave unset to take the default pinned in compose.amira.yml; set it with
# deploy/amira/update-amira-mcp.sh rather than by hand.
# AMIRA_MCP_VERSION=
#
# Memory ceiling of amira-mcp and its V8 heap cap (MB). Keep the heap ~128M
# below the limit, for V8's non-heap memory and the /tmp cache; raise both
# together.
# AMIRA_MCP_MEMORY_LIMIT=512M
# AMIRA_MCP_HEAP_MB=384

# AMIRA overlay only, with the "curator" profile (COMPOSE_PROFILES=search,curator):
# the internal curator MCP endpoint at /curator/mcp. See
# deploy/amira/README.md#curator-mcp-endpoint before switching it on.
#
# The amira-mcp-server release to build it from: v1.36.0 or later (the first
# releases with curator mode and AMIRA_API_BASE). No default, and
# update-amira-mcp.sh does not move it; bump it yourself.
# AMIRA_MCP_CURATOR_VERSION=v1.38.1
#
# The user it runs as: the owner of the secrets directory (`id -u`, `id -g`),
# so the Omeka key can stay mode 0600.
# AMIRA_CURATOR_UID=1000
# AMIRA_CURATOR_GID=1000
# Memory ceiling of the curator container and its V8 heap cap. Heap plus the
# 128M cache tmpfs must stay under the limit (448 + 128 < 640). Both Node
# servers crashed with "JavaScript heap out of memory" before the heap was
# capped. On the 3.8 GiB reference host, take the room from php
# (PHP_CONTAINER_MEMORY).
# AMIRA_CURATOR_MEMORY_LIMIT=640M
# AMIRA_CURATOR_HEAP_MB=448
#
# Where the Omeka key and token hashes live (gitignored by default).
# AMIRA_CURATOR_SECRETS_DIR=./deploy/amira/curator-secrets
