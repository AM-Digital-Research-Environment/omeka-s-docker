# Omeka S Docker Template - Environment Configuration
# Copy this file to .env and update the values

# MySQL password (required - use a strong password)
MYSQL_PASSWORD=your_secure_mysql_password_here

# If you set any of these, the installer will create a default
# installation with default credentials:
# User: admin@example.com
# Password: admin
# It is therefore recommended to set all values if you intend
# to skip the Omeka install page.
# OMEKA_ADMIN_EMAIL=
# OMEKA_ADMIN_PASSWORD=
# OMEKA_ADMIN_USERNAME=
# OMEKA_TZ="Europe/Berlin"
# OMEKA_LOCALE="en_US"
# OMEKA_TITLE=

# Nginx port (optional, defaults to 80)
# NGINX_PORT=80

# Interface the nginx port binds to (optional, defaults to 127.0.0.1).
# The default keeps the stack reachable only through a reverse proxy running
# on the host (Caddy, nginx, Traefik). Set 0.0.0.0 to serve HTTP directly,
# e.g. for a plain install without a proxy.
# NGINX_BIND=127.0.0.1

# Public hostname this Omeka S instance is served on (used in nginx server_name).
# Defaults to "_" (catch-all) if unset, which is fine when the container only
# accepts traffic from a trusted reverse proxy on 127.0.0.1.
# SERVER_NAME=omeka.example.edu

# CSP frame-ancestors: origins allowed to embed this site in an iframe.
# Defaults to 'self' (only the site itself). Space-separated origins; keep the
# literal quotes around 'self' and wrap the whole value in double quotes.
# FRAME_ANCESTORS="'self' https://www.example.org"

# Extra modules/themes (optional, comma-separated)
# EXTRA_MODULES=DspaceConnector,CSSEditor
# EXTRA_THEMES=Cozy,Foundation

# IIIF support (optional - installs IiifServer, ImageServer, Mirador)
# ENABLE_IIIF=true

# Typesense search backend for the DRESearch module (OPTIONAL).
# This stack runs fine without it — the search service only starts when you
# explicitly enable the "search" profile:
#   docker compose --profile search up -d
# Typesense stays on the internal network (never exposed to the host); the
# module talks to it server-side. Set a long random key — it is used by both
# the Typesense server and the module. Leave unset to run without search.
# TYPESENSE_API_KEY=change-me-to-a-long-random-string
# TYPESENSE_HOST=typesense
# TYPESENSE_PORT=8108
# TYPESENSE_PROTOCOL=http

# PHP-FPM pool tuning (optional - uncomment to override defaults)
# PHP_PM_MAX_CHILDREN=10
# PHP_PM_START_SERVERS=3
# PHP_PM_MIN_SPARE_SERVERS=2
# PHP_PM_MAX_SPARE_SERVERS=5
# PHP_PM_MAX_REQUESTS=500

# ── Deployment overlays ──────────────────────────────────────────────────────
# Extra compose files layered on top of docker-compose.yml. Docker Compose
# reads COMPOSE_FILE and COMPOSE_PROFILES from this file, so activating an
# overlay is a one-time .env edit — every `docker compose` command then picks
# it up automatically. Example: the AMIRA production overlay
# (see deploy/amira/README.md):
# COMPOSE_FILE=docker-compose.yml:compose.amira.yml
# COMPOSE_PROFILES=search
