# Omeka S Docker Template - Environment Configuration
# Copy this file to .env and update the values

# MySQL password (required - use a strong password)
MYSQL_PASSWORD=your_secure_mysql_password_here

# If you set any of these, the installer will create a default
# installation with default credentials:
# User: admin@example.com
# Password: admin
# It is therefore recommended to set all values if you intend
# to skip the Omeka install page.
# OMEKA_ADMIN_EMAIL=
# OMEKA_ADMIN_PASSWORD=
# OMEKA_ADMIN_USERNAME=
# OMEKA_TZ="Europe/Berlin"
# OMEKA_LOCALE="en_US"
# OMEKA_TITLE=

# Nginx port (optional, defaults to 80)
# NGINX_PORT=80

# Extra modules/themes (optional, comma-separated)
# EXTRA_MODULES=EasyAdmin,CSSEditor
# EXTRA_THEMES=Cozy,Foundation

# IIIF support (optional - installs IiifServer, ImageServer, Mirador)
# ENABLE_IIIF=true

# PHP-FPM pool tuning (optional - uncomment to override defaults)
# PHP_PM_MAX_CHILDREN=10
# PHP_PM_START_SERVERS=3
# PHP_PM_MIN_SPARE_SERVERS=2
# PHP_PM_MAX_SPARE_SERVERS=5
# PHP_PM_MAX_REQUESTS=500
